# Copy this file to .env and fill it in. NEVER commit .env (it's in .gitignore).

NODE_ENV=development
PORT=3000

# Frontend address(es) allowed to call the API, comma-separated. VS Code Live Server uses port 5500.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Set to true only when deployed behind a proxy (Render, Railway, Nginx).
TRUST_PROXY=false

# Long random secret that signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Only emails on these domains (and their subdomains, e.g. gbox.adnu.edu.ph) can sign up.
ALLOWED_EMAIL_DOMAINS=adnu.edu.ph

# First admin account, created at startup (password: 12+ characters).
SEED_ADMIN_EMAIL=admin@adnu.edu.ph
SEED_ADMIN_PASSWORD=
